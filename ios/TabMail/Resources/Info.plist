<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>one.darker.tempomail.sync</string>
		<string>one.darker.tempomail.ai-processing</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>TEMPO Mail</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>TEMPO Mail</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Google OAuth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(GOOGLE_REDIRECT_SCHEME)</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>Microsoft OAuth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(MICROSOFT_REDIRECT_SCHEME)</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>TEMPO Mail</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>tempo-mail</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>Mail</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mailto</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>DEMO_CLIENT_SECRET</key>
	<string>$(DEMO_CLIENT_SECRET)</string>
	<key>GOOGLE_CLIENT_ID</key>
	<string>$(GOOGLE_CLIENT_ID)</string>
	<key>GOOGLE_REDIRECT_SCHEME</key>
	<string>$(GOOGLE_REDIRECT_SCHEME)</string>
	<key>IMAP_CRED_ENCRYPTION_KEY_DEV</key>
	<string>$(IMAP_CRED_ENCRYPTION_KEY_DEV)</string>
	<key>IMAP_CRED_ENCRYPTION_KEY_PROD</key>
	<string>$(IMAP_CRED_ENCRYPTION_KEY_PROD)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MICROSOFT_CLIENT_ID</key>
	<string>$(MICROSOFT_CLIENT_ID)</string>
	<key>MICROSOFT_REDIRECT_SCHEME</key>
	<string>$(MICROSOFT_REDIRECT_SCHEME)</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>TEMPO Mail 使用日历权限，将邮件中的日程邀请添加到系统日历。</string>
	<key>NSCameraUsageDescription</key>
	<string>TEMPO Mail 使用相机拍摄邮件附件。</string>
	<key>NSContactsUsageDescription</key>
	<string>TEMPO Mail 使用通讯录，在写邮件时建议收件人。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>TEMPO Mail 使用麦克风进行语音输入。录音只用于转写，不会保存在设备外。</string>
	<key>TabMailProtocolVersion</key>
	<string>$(TABMAIL_PROTOCOL_VERSION)</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
